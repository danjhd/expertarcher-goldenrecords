# API credentials (copied from .env.example). The template is committed; the
# real file with secrets is not.
.env

# Member data downloaded from the API (contains personal data)
golden-records/members.json

# Full detail of rejected submissions, written per run for review
submission-errors.log

# Generated CSV bulk-import files (contain member names). The committed
# score-records.csv is Golden Records' fake-data sample, so it is not matched.
*-import.csv

# uv / virtual environment
.venv/

# SAM build artefacts
aws/.aws-sam/

# Deploy config holding the API keys, used via `sam deploy --config-file`.
# The committed aws/samconfig.toml has no secrets in it.
aws/samconfig.local.toml

# Dependencies of the pre-deploy checker in tools/ (package-lock.json is committed)
tools/node_modules/

# Python
__pycache__/
*.pyc
.claude
